# JARVIS Configuration Template
# Copy this file and set your actual token

# Your Anthropic Auth Token
# Get this from your omniroute setup
ANTHROPIC_AUTH_TOKEN=your-token-here

# Other settings (usually don't need to change these)
CLAUDE_CONFIG_DIR=%USERPROFILE%\.claude-omniroute
ANTHROPIC_BASE_URL=http://localhost:20128
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=omniroute-free
